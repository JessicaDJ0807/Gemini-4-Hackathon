PORT=3000
# Leave both empty to use the labeled local mock of A's service.
# Set both to connect B to A. Credentials stay on B's server.
AI_BASE_URL=
AI_SERVICE_TOKEN=
# Optional: enable Places API (New) and billing for this server-side key.
GOOGLE_MAPS_API_KEY=

# Optional photo-to-style suggestions. Independent of A / mock outfit mode.
# Server-only: never put this key in browser code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# Optional A+B live launcher settings (npm run dev:full).
AI_PORT=8001
# A must be able to reach this URL to download wardrobe photos.
PUBLIC_APP_URL=http://127.0.0.1:3000
# Defaults to GEMINI_MODEL in dev:full. Keep API keys server-side.
OUTFIT_MODEL=gemini-4-hydrogen
