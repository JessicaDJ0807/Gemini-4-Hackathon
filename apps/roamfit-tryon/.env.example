# Copy to .env and fill in locally. NEVER commit .env. Keys are read by the Node server only (never VITE_* / browser).

# --- Required for generation (Google Gemini API) ---
GEMINI_API_KEY=
# Two DIFFERENT Gemini 4 models: A = planner (reads appearance / garments), B = visual review. Check with `npm run probe`.
GEMINI4_PLANNER_MODEL=gemini-4-neon
GEMINI4_QA_MODEL=gemini-4-carbon
# Image generator (Gemini 3.1 Flash Image lineage, NOT Gemini 4).
IMAGE_PROVIDER=gemini
IMAGE_MODEL=gemini-nano-banana-2.1
# Optional rotating-preview video (NOT Gemini 4; paid per second, only on explicit user confirmation).
VIDEO_MODEL=gemini-omni-1.2-flash

# --- Server ---
PORT=8787
# Hosts the server may fetch team/Shopify garment images from (https only, comma-separated). Local fixture paths are always allowed.
TRYON_MEDIA_ALLOWED_HOSTS=cdn.shopify.com
# Optional folder OUTSIDE the repo holding private assets (e.g. derived/person_front.png demo photo). Default: ../assets
ROAMFIT_PRIVATE_ASSETS_DIR=

# --- Optional / other routes ---
# Original app (default route) + Shopify recommendations
GEMINI_REASONING_MODEL=gemini-4-argon
GEMINI_QA_MODEL=gemini-4-argon
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
# #/tryon contract studio (server/preview): live personalised previews stay OFF unless 1 AND the user consents.
TRYON_LIVE_ENABLED=0
# Team AI service proxy (optional). Token stays server-side.
TEAM_AI_BASE_URL=
AI_SERVICE_TOKEN=
# Experimental 3D providers are disabled; leave empty.
ENABLE_3D_PROVIDERS=
FAL_KEY=
