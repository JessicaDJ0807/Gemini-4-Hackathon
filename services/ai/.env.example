# services/ai/.env.example — copy to .env
GEMINI_API_KEY=your-key-here

# Optional model overrides (run `python hello_gemini.py --list-models`)
GEMINI_MODEL=
STYLE_MODEL=gemini-4-neon
OUTFIT_MODEL=gemini-4-hydrogen
PREVIEW_BRIEF_MODEL=gemini-4-hydrogen
IMAGE_MODEL=gemini-3.1-flash-image   # no Gemini 4 model outputs images

# Optional: only fetch media from these hosts (comma-separated). Unset = any host (dev only)
MEDIA_ALLOWED_HOSTS=

# Optional: require "Authorization: Bearer <token>" on API calls
AI_SERVICE_TOKEN=
